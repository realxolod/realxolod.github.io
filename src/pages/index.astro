---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const githubUrl = 'https://github.com';

const stack = ['Python', 'SQL', 'C', 'Pandas', 'VBA', 'Excel', 'Financial Analysis', 'HTML/CSS'];
const languages = [
  { key: 'langEn', label: 'English (C1)' },
  { key: 'langCz', label: 'Czech (B2/C1)' },
  { key: 'langNative', label: 'Russian & Kazakh (Native)' },
];

const filters = [
  { id: 'normal', label: 'Normal', i18n: 'filterNormal' },
  { id: 'grayscale', label: 'Grayscale', i18n: 'filterGrayscale' },
  { id: 'blur', label: 'Box Blur', i18n: 'filterBlur' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <title>Aidar S.</title>
    <meta
      name="description"
      content="Aidar S. — Informatics in Economics student at VŠB-TUO. Python data pipelines, low-level C and business numbers."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="relative text-zinc-300 antialiased overflow-x-hidden">
    <!-- Ambient background layers -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <!-- In Rainbows aurora (fades in when Radiohead is playing) -->
      <div
        id="aurora"
        class="absolute inset-0 opacity-0 transition-opacity duration-1000"
      >
        <div class="aurora-blob absolute -top-24 left-[12%] h-[420px] w-[420px] rounded-full bg-[#9A3412] blur-3xl"></div>
        <div class="aurora-blob aurora-blob-2 absolute top-[22%] right-[10%] h-[460px] w-[460px] rounded-full bg-[#1E3A8A] blur-3xl"></div>
        <div class="aurora-blob aurora-blob-3 absolute bottom-[-10%] left-[28%] h-[400px] w-[400px] rounded-full bg-[#065F46] blur-3xl"></div>
      </div>

      <!-- 600px cursor spotlight -->
      <div id="spotlight" class="bg-spotlight absolute inset-0"></div>

      <!-- Matte SVG noise -->
      <div class="bg-noise absolute inset-0"></div>
    </div>

    <main class="relative z-10 max-w-[600px] mx-auto px-6 pt-20 pb-16 sm:pt-28">
      <!-- Header -->
      <header>
        <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-zinc-500">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="inline-flex items-center gap-2">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/60"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              </span>
              <time id="clock" class="tabular-nums text-zinc-300">--:--:--</time>
            </span>
            <span class="text-zinc-700">/</span>
            <span data-i18n="status">Ostrava, CZ • Volný přístup na trh práce v ČR</span>
          </div>

          <div
            role="group"
            aria-label="Language switcher"
            class="flex items-center gap-1 font-mono text-[11px] text-zinc-600"
          >
            <button
              type="button"
              data-lang="en"
              data-click
              aria-pressed="true"
              class="text-zinc-100 transition-colors hover:text-zinc-100"
            >
              EN
            </button>
            <span aria-hidden="true">/</span>
            <button
              type="button"
              data-lang="cz"
              data-click
              aria-pressed="false"
              class="text-zinc-500 transition-colors hover:text-zinc-100"
            >
              CZ
            </button>
            <span aria-hidden="true">/</span>
            <button
              type="button"
              data-lang="ru"
              data-click
              aria-pressed="false"
              class="text-zinc-500 transition-colors hover:text-zinc-100"
            >
              RU
            </button>
          </div>
        </div>

        <h1 class="mt-8 text-3xl font-semibold tracking-tight text-zinc-100">
          <span data-i18n="greeting">Hey, I'm Aidar S.</span> <span class="wave" aria-hidden="true">👋</span>
        </h1>

        <p data-i18n="bio" class="mt-4 text-[15px] leading-relaxed text-zinc-400">
          I study Informatics in Economics at VŠB-TUO. I like turning messy data into clean Python
          pipelines, poking around with low-level C, and figuring out how business numbers actually
          work.
        </p>

        <nav aria-label="Contact links" class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            data-click
            class="text-zinc-400 underline decoration-zinc-700 underline-offset-4 transition-colors duration-200 hover:text-zinc-100 hover:decoration-zinc-400"
          >
            GitHub ↗
          </a>
          <a
            id="tg-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer nofollow"
            data-click
            class="text-zinc-400 underline decoration-zinc-700 underline-offset-4 transition-colors duration-200 hover:text-zinc-100 hover:decoration-zinc-400"
          >
            Telegram ↗
          </a>
          <div class="relative inline-flex items-center">
            <button
              id="copy-email-btn"
              type="button"
              data-click
              data-i18n="copyEmail"
              class="text-zinc-400 underline decoration-zinc-700 underline-offset-4 transition-colors duration-200 hover:text-zinc-100 hover:decoration-zinc-400"
            >
              Copy Email
            </button>
            <span
              id="copy-toast"
              role="status"
              aria-live="polite"
              data-i18n="copied"
              class="pointer-events-none absolute left-full ml-2.5 translate-y-1 whitespace-nowrap rounded-md border border-emerald-500/30 bg-emerald-950/80 px-2 py-0.5 font-mono text-[11px] text-emerald-300 opacity-0 transition-all duration-200"
            >
              Copied!
            </span>
          </div>
          <button
            id="sound-toggle"
            type="button"
            aria-pressed="true"
            class="ml-auto font-mono text-xs text-zinc-600 transition-colors hover:text-zinc-300"
          >
            sound: on
          </button>
        </nav>
      </header>

      <!-- Widgets -->
      <section aria-label="Toys" class="mt-14 grid grid-cols-1 gap-3 sm:grid-cols-2 items-start">
        <!-- Radiohead player -->
        <div id="player" class="flex flex-col justify-between gap-3 rounded-xl border border-zinc-800/70 bg-zinc-900/50 p-3.5 backdrop-blur-md">
          <audio id="radio-audio" preload="none"></audio>

          <div class="flex items-center gap-3.5">
            <!-- Left: Black vinyl with iTunes album artwork center label -->
            <div class="vinyl relative h-12 w-12 shrink-0 rounded-full" aria-hidden="true">
              <div class="in-rainbows-label absolute inset-[26%] overflow-hidden rounded-full">
                <img
                  id="vinyl-artwork"
                  alt=""
                  class="h-full w-full object-cover opacity-0 transition-opacity duration-300"
                />
                <div class="absolute inset-[36%] rounded-full bg-[#0C0C0E] ring-1 ring-white/10"></div>
              </div>
            </div>

            <!-- Middle: Status + 3-bar EQ + Track title -->
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="truncate font-mono text-[11px] text-zinc-500">
                  NOW SPINNING // CODING VIBE
                </span>
                <span id="eq" class="flex h-3 shrink-0 items-end gap-[2px]" aria-hidden="true">
                  <span class="eq-bar block w-[2px] rounded-full bg-amber-400/90"></span>
                  <span class="eq-bar block w-[2px] rounded-full bg-orange-400/90"></span>
                  <span class="eq-bar block w-[2px] rounded-full bg-sky-400/90"></span>
                </span>
              </div>

              <div class="mt-0.5">
                <span
                  id="track-title"
                  class="block truncate text-[13px] font-medium text-zinc-100"
                  title="Radiohead — Weird Fishes / Arpeggi"
                >
                  Radiohead — Weird Fishes / Arpeggi
                </span>
                <span id="track-meta" class="block truncate font-mono text-[10.5px] text-zinc-500">
                  Loading iTunes preview...
                </span>
              </div>
            </div>
          </div>

          <!-- Thin progress bar -->
          <div class="space-y-1.5">
            <div
              id="progress-track"
              role="progressbar"
              aria-label="Track progress"
              class="h-1 w-full cursor-pointer overflow-hidden rounded-full bg-zinc-800"
            >
              <div id="progress-bar" class="h-full w-0 rounded-full bg-amber-400/90 transition-[width] duration-150"></div>
            </div>

            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 font-mono text-[10.5px] text-zinc-500">
                <span id="track-time">0:00 / 0:30</span>
                <span class="text-zinc-700">•</span>
                <span id="track-counter">1/3</span>
              </div>

              <div class="flex shrink-0 items-center gap-1">
                <button
                  id="prev-btn"
                  type="button"
                  data-click
                  aria-label="Previous track"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-zinc-800 bg-zinc-950/60 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-100"
                >
                  <svg viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor" aria-hidden="true">
                    <path d="M3 3h1.5v10H3V3zm2.5 5l7-4.5v9L5.5 8z" />
                  </svg>
                </button>

                <button
                  id="play-btn"
                  type="button"
                  data-click
                  aria-pressed="false"
                  aria-label="Play"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-zinc-100 text-zinc-900 transition-colors hover:bg-white"
                >
                  <svg id="icon-play" viewBox="0 0 16 16" class="h-3 w-3 translate-x-[0.5px]" fill="currentColor" aria-hidden="true">
                    <path d="M4 2.5v11l9-5.5z" />
                  </svg>
                  <svg id="icon-pause" viewBox="0 0 16 16" class="hidden h-3 w-3" fill="currentColor" aria-hidden="true">
                    <path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" />
                  </svg>
                </button>

                <button
                  id="next-btn"
                  type="button"
                  data-click
                  aria-label="Next track"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-zinc-800 bg-zinc-950/60 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-100"
                >
                  <svg viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor" aria-hidden="true">
                    <path d="M11.5 3H13v10h-1.5V3zM3.5 12.5v-9l7 4.5-7 4.5z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Pixel filter toy -->
        <div class="flex flex-col gap-3 rounded-xl border border-zinc-800/70 bg-zinc-900/40 p-4 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <span data-i18n="pixelFilter" class="text-xs text-zinc-500">Pixel filter</span>
            <code id="filter-op" class="font-mono text-[11px] text-zinc-600">normal()</code>
          </div>

          <canvas
            id="filter-canvas"
            width="48"
            height="30"
            class="pixelated aspect-[48/30] w-full rounded-md"
            aria-label="Pixel art sunset processed by the selected filter"
          ></canvas>

          <div class="flex items-center gap-1" role="group" aria-label="Filter">
            {filters.map((f) => (
              <button
                type="button"
                data-filter={f.id}
                data-i18n={f.i18n}
                data-click
                class="rounded-md px-2 py-1 text-xs text-zinc-400 transition-colors hover:text-zinc-100"
              >
                {f.label}
              </button>
            ))}
          </div>

          <input
            id="filter-intensity"
            type="range"
            min="0"
            max="100"
            value="100"
            aria-label="Filter intensity"
            class="range w-full"
          />
        </div>
      </section>

      <!-- Projects -->
      <section aria-labelledby="projects-heading" class="mt-16">
        <h2 id="projects-heading" data-i18n="projects" class="mb-3 text-sm font-medium text-zinc-500">Projects</h2>

        <ul class="border-t border-zinc-800/80">
          {projects.map((project) => (
            <li class="border-b border-zinc-800/80">
              <div class="group -mx-3 rounded-lg px-3 py-4 transition-all duration-200 hover:translate-x-1 hover:bg-white/[0.025]">
                <div class="flex items-baseline justify-between gap-4">
                  <div class="flex min-w-0 flex-wrap items-baseline gap-x-2.5 gap-y-1">
                    <h3 class="text-[15px] font-medium text-zinc-200 transition-colors group-hover:text-zinc-50">
                      {project.data.title}
                    </h3>
                    <span class="font-mono text-xs text-zinc-500">{project.data.stack.join(' · ')}</span>
                    {project.data.status && (
                      <span data-i18n="statusInProgress" class="font-mono text-[11px] text-amber-400/90">[{project.data.status}]</span>
                    )}
                  </div>
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    data-click
                    class="shrink-0 text-xs text-zinc-500 transition-colors hover:text-zinc-100"
                  >
                    GitHub ↗
                  </a>
                </div>
                <p
                  data-i18n={`proj.${project.slug}`}
                  class="mt-1.5 text-sm leading-relaxed text-zinc-500 transition-colors group-hover:text-zinc-400"
                >
                  {project.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Stack & languages -->
      <footer class="mt-16 space-y-3 text-sm">
        <div class="flex flex-wrap items-baseline gap-1.5">
          <span data-i18n="stackLabel" class="mr-1.5 font-medium text-zinc-300">Stack:</span>
          {stack.map((item) => (
            <span class="rounded-md bg-zinc-800/50 px-2 py-0.5 text-xs text-zinc-400">{item}</span>
          ))}
        </div>
        <div class="flex flex-wrap items-baseline gap-1.5">
          <span data-i18n="languagesLabel" class="mr-1.5 font-medium text-zinc-300">Languages:</span>
          {languages.map((item) => (
            <span data-i18n={item.key} class="rounded-md bg-zinc-800/50 px-2 py-0.5 text-xs text-zinc-400">
              {item.label}
            </span>
          ))}
        </div>

        <p class="pt-10 font-mono text-xs text-zinc-600">© 2026 Aidar S.</p>
      </footer>
    </main>

    <script>
      import { initClock } from '../scripts/clock';
      import { initClickSounds } from '../scripts/audio';
      import { initContacts } from '../scripts/contacts';
      import { initSpotlight } from '../scripts/ambient';
      import { initI18n } from '../scripts/i18n';
      import { initRadio } from '../scripts/radio';
      import { initFilterToy } from '../scripts/filter';

      initClock();
      initClickSounds();
      initContacts();
      initSpotlight();
      initI18n();
      initRadio();
      initFilterToy();
    </script>
  </body>
</html>
